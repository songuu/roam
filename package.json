{
  "name": "roam-travel-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "start": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "^19.1.1", "react-dom": "^19.1.1", "express": "^5.1.0",
    "zod": "^3.25.76", "multer": "^2.0.2", "sharp": "^0.35.5",
    "helmet": "^8.1.0", "dotenv": "^17.2.2", "lucide-react": "^0.468.0",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "typescript": "^5.9.2", "vite": "^7.1.5", "@vitejs/plugin-react": "^5.0.2",
    "tsx": "^4.20.5", "concurrently": "^9.2.1", "vitest": "^5.0.3",
    "supertest": "^7.1.4", "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.6", "@types/react": "^19.1.13", "@types/react-dom": "^19.1.9",
    "@types/express": "^5.0.3", "@types/multer": "^2.0.0", "@types/supertest": "^6.0.3", "@types/leaflet": "^1.9.20"
  }
}
