# 所有密钥仅由服务端读取。复制为 .env 后按需配置。
HOST=127.0.0.1
PORT=3001
DATA_DIR=./data
APP_ORIGIN=http://127.0.0.1:5173
WEATHER_ENABLED=true

# 可选：OpenAI-compatible Chat Completions；未配置时使用可解释规则引擎。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# 可选：高德 Web 服务 key，扩展本地目录之外的目的地检索。
AMAP_KEY=
